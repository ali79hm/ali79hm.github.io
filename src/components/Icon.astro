  education: "m2 9 10-5 10 5-10 5zm4 2v5c3 2 9 2 12 0v-5",
  contact: "m3 11 18-8-8 18-2-7z",
  pin: "M12 22s7-7 7-13A7 7 0 0 0 5 9c0 6 7 13 7 13Zm0-10a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
  mail: "M3 5h18v14H3zm0 1 9 7 9-7",
  github: "M12 2a10 10 0 0 0-3 19.5v-2.2c-2.4.5-3-1-3-1-.4-1-1-1.3-1.3-.7-.5 0-.5.1-.5 1 .1 1.5 1 1.7 1.3.9.2 1.7 0 2.1-.2.1-.7.4-1.1.7-1.8-2.8-.3-5.7-1.4-5.7-6.2 0-1.4.5-2.6 1.3-3.5-.1-.3-.6-1.7.1-3.5 0 0 1.1-.4 3.6 1.3a12.5 12.5 0 0 1 6.6 0C18.8 5.8 20 6.2 20 6.2c.7 1.8.2 3.2.1 3.5.8.9 1.3 2.1 1.3 3.5 0 4.8-2.9 5.9-5.7 6.2.5.4.8 1.1.8 2.1v3A10 10 0 0 0 12 2Z",
  linkedin: "M5 8H2v12h3zM3.5 3a1.8 1.8 0 1 0 0 3.6A1.8 1.8 0 0 0 3.5 3ZM9 8H6v12h3v-6c0-4 5-4 5 0v6h3v-7c0-6-6-5-8-2z",
