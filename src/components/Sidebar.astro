---
import Icon from "./Icon.astro";
const links = [
  ["home", "Home", "home"], ["about", "About Me", "person"], ["skills", "Skills", "skills"],
  ["experience", "Experiences", "work"], ["projects", "Projects", "projects"],
  ["education", "Education", "education"],
] as const;
---

<aside class="sidebar" aria-label="Main navigation">
  <button class="tablet-menu-button" aria-label="Open navigation" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <div class="sidebar-brand-space" aria-hidden="true">
    <svg class="tablet-brand" viewBox="0 0 80 60" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
      <path d="M3 53 23 23 29 32 39 9 53 33 59 23 77 53 53 42 43 33 34 44 24 39 Z" />
      <path d="m3 53 25-19 9-15 8 18 8-4 24 20M15 43l8-20m30 19 6-19M24 39l-6 12 16-7 9-11 14 19" />
    </svg>
  </div>
  <nav>
    {links.map(([id, label, icon]) => (
      <a href={`#${id}`}>
        <Icon name={icon} /><span>{label}</span>
      </a>
    ))}
  </nav>
  <a class="resume-nav-link" href="/resume/seyed_ali_hosseini_mirzaee_resume.pdf" download>
    <Icon name="download" size={18} /><span>Download Resume</span>
  </a>
</aside>

<header class="mobile-header">
  <button class="menu-button" aria-label="Open navigation" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <nav class="mobile-nav" aria-label="Mobile navigation">
    {links.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    <a class="resume-link" href="/resume/seyed_ali_hosseini_mirzaee_resume.pdf" download>Download Resume</a>
  </nav>
</header>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".menu-button, .tablet-menu-button");
  const sidebar = document.querySelector<HTMLElement>(".sidebar");
  const nav = document.querySelector<HTMLElement>(".mobile-nav");
  const closeMenu = () => {
    buttons.forEach((button) => button.setAttribute("aria-expanded", "false"));
    sidebar?.classList.remove("drawer-open");
    nav?.classList.remove("open");
  };
  buttons.forEach((button) => button.addEventListener("click", () => {
    const isOpen = button.getAttribute("aria-expanded") === "true";
    buttons.forEach((menuButton) => menuButton.setAttribute("aria-expanded", String(!isOpen)));
    sidebar?.classList.toggle("drawer-open", !isOpen);
    nav?.classList.toggle("open", !isOpen);
  }));
  nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));

  const sectionLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.sidebar nav a[href^="#"]'),
  );
  const sections = sectionLinks
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => section !== null);
  // Preserve an incoming anchor while the browser positions the page.
  // Otherwise the initial scroll position can overwrite #experience with #home.
  const getRequestedSection = () =>
    sections.find((section) => "#" + section.id === window.location.hash)?.id ?? null;
  let manuallySelectedId: string | null = getRequestedSection();

  const setActiveSection = (id: string) => {
    document.querySelectorAll<HTMLAnchorElement>('.sidebar nav a[href^="#"], .mobile-nav a[href^="#"]').forEach((link) => {
      const isActive = link.hash === "#" + id;
      link.classList.toggle("active", isActive);
      if (isActive) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });

    const nextHash = "#" + id;
    if (window.location.hash !== nextHash) {
      window.history.replaceState(null, "", nextHash);
    }
  };

  const updateActiveSection = () => {
    if (manuallySelectedId) {
      setActiveSection(manuallySelectedId);
      return;
    }

    const marker = window.scrollY + window.innerHeight * 0.35;
    let current: HTMLElement | undefined = sections[0];
    let currentTop = current
      ? current.getBoundingClientRect().top + window.scrollY
      : Number.NEGATIVE_INFINITY;

    for (const section of sections) {
      const sectionTop = section.getBoundingClientRect().top + window.scrollY;
      if (sectionTop > marker) break;
      // Panels on the same row share a vertical position. Keep the first one,
      // matching the page's left-to-right reading order.
      if (sectionTop > currentTop + 2) {
        current = section;
        currentTop = sectionTop;
      }
    }

    if (current) setActiveSection(current.id);
  };

  let scrollFrame = 0;
  const requestActiveSectionUpdate = () => {
    if (scrollFrame) return;
    scrollFrame = window.requestAnimationFrame(() => {
      updateActiveSection();
      scrollFrame = 0;
    });
  };

  sectionLinks.forEach((link) => {
    link.addEventListener("click", () => {
      manuallySelectedId = link.hash.slice(1);
      setActiveSection(manuallySelectedId);
    });
  });

  const resumeScrollTracking = () => {
    manuallySelectedId = null;
  };

  window.addEventListener("hashchange", () => {
    manuallySelectedId = getRequestedSection();
    updateActiveSection();
  });

  window.addEventListener("wheel", resumeScrollTracking, { passive: true });
  window.addEventListener("touchstart", resumeScrollTracking, { passive: true });
  window.addEventListener("pointerdown", resumeScrollTracking, { passive: true });
  window.addEventListener("keydown", (event) => {
    if (["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End", " "].includes(event.key)) {
      resumeScrollTracking();
    }
  });

  updateActiveSection();
  window.addEventListener("scroll", requestActiveSectionUpdate, { passive: true });
  window.addEventListener("resize", requestActiveSectionUpdate);
</script>
