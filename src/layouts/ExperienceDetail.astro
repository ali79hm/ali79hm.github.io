---
import BaseLayout from "./BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";

interface Props {
  role: string;
  company: string;
  dateFrom: string;
  dateTo: string;
  location: string;
  image: string;
  imageAlt: string;
  description: string;
  responsibilities: {
    title: string;
    body: string;
    icon: string;
    lineIcon?: boolean;
  }[];
}

const { role, company, dateFrom, dateTo, location, image, imageAlt, description, responsibilities } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${role} at ${company} — Seyed Ali Hosseini`} description={description}>
  <header class="detail-nav">
    <a class="detail-brand" href={`${base}`}>SEYED ALI HOSSEINI</a>
    <nav aria-label="Portfolio navigation">
      <a href={`${base}#home`}>Home</a>
      <a href={`${base}#about`}>About</a>
      <a class="active" href={`${base}#experience`}>Experience</a>
      <a href={`${base}#projects`}>Projects</a>
      <a href={`${base}#contact`}>Contact</a>
    </nav>
  </header>

  <main class="experience-detail">
    <section class="detail-hero" aria-labelledby="experience-title">
      <img src={`${base}${image}`} alt={imageAlt} />
      <a class="back-link" href={`${base}#experience`} aria-label="Back to experience section">
        <span aria-hidden="true">←</span> Back to experience
      </a>
      <div class="role-card">
        <h1 id="experience-title">{role}</h1>
        <p class="role-company">{company}</p>
        <p class="role-date">{dateFrom} <span>—</span> {dateTo}</p>
        <p class="role-location"><img src={`${base}svgs/location.svg`} alt="" /> {location}</p>
      </div>
    </section>

    <section class="responsibilities" aria-labelledby="responsibilities-title">
      <div id="responsibilities-title" class="responsibilities-heading">
        <SectionTitle label="Key responsibilities" />
      </div>
      <div class="responsibility-grid">
        {responsibilities.map((item) => (
          <article class="responsibility-card">
            <svg class:list={["responsibility-icon", { "line-icon": item.lineIcon }]} viewBox="0 0 46 46" aria-hidden="true">
              <path d={item.icon} />
            </svg>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .detail-nav { position: sticky; top: 0; z-index: 20; min-height: 62px; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 10px clamp(18px, 4vw, 64px); color: white; background: var(--ink); border-bottom: 3px solid #080b10; }
  .detail-brand { color: white; font: 700 1.05rem "Kalam", cursive; transform: rotate(-1deg); }
  .detail-nav nav { display: flex; flex-wrap: wrap; gap: clamp(14px, 2.5vw, 34px); }
  .detail-nav nav a { position: relative; color: #e7e9ed; font: 600 .82rem "Oswald", sans-serif; letter-spacing: .04em; text-transform: uppercase; }
  .detail-nav nav a::after { content: ""; position: absolute; left: 0; right: 100%; bottom: -6px; height: 3px; background: var(--yellow); transition: right .18s ease; }
  .detail-nav nav a:hover::after, .detail-nav nav a.active::after { right: 0; }
  .experience-detail {
    /* Title box rotation: negative tilts left, positive tilts right. */
    --role-card-angle: -8deg;
    container-type: inline-size;
    width: min(1220px, calc(100% - 24px));
    max-width: none;
    margin: 0 auto;
    padding: 0 0 42px;
  }
  .back-link { position: absolute; z-index: 4; top: 0; left: 0; width: max-content; display: flex; align-items: center; gap: 8px; margin: 0; padding: 10px 18px 8px; color: var(--ink); background: rgba(255, 253, 247, .96); border: 0 solid var(--ink); border-right-width: 3px; border-bottom-width: 3px; font-weight: 700; text-transform: uppercase; transform: rotate(-.4deg); transform-origin: top left; }
  .back-link span { font: 700 1.4rem/1 sans-serif; transition: transform .15s ease; }
  .back-link:hover span { transform: translateX(-4px); }
  .detail-hero { position: relative; height: clamp(440px, 50cqw, 610px); overflow: hidden; background: #d8aa6d; border: 3px solid var(--ink); box-shadow: 5px 6px 0 var(--ink); clip-path: polygon(.25% .5%, 99.6% 0, 100% 99.2%, 50% 99.7%, .4% 99.1%, 0 50%); }
  .detail-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(17, 23, 32, .15), transparent 52%); pointer-events: none; }
  .detail-hero > img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .role-card { position: absolute; z-index: 2; isolation: isolate; left: clamp(22px, 5.6cqw, 68px); top: clamp(78px, 8.5cqw, 104px); width: 41cqw; padding: clamp(25px, 3.2cqw, 39px) clamp(38px, 4.9cqw, 60px) clamp(25px, 3cqw, 37px) clamp(42px, 4.75cqw, 58px); background: transparent; filter: drop-shadow(5px 5px 0 var(--ink)); transform: rotate(var(--role-card-angle)); transform-origin: center; }
  .role-card::before, .role-card::after { content: ""; position: absolute; z-index: -2; clip-path: polygon(7% 0, 100% 0, 93% 100%, 0 100%); }
  .role-card::before { inset: 0; background: var(--ink); }
  .role-card::after { z-index: -1; inset: 3px; background: rgba(255, 253, 247, .98); }
  .role-card h1 { margin: 0 0 7px; max-width: 100%; font: 700 clamp(2.15rem, 5.25cqw, 4rem)/.95 "Kalam", cursive; letter-spacing: -.065em; white-space: nowrap; }
  .role-company { margin: 0; color: #0c579c; font-size: clamp(1.25rem, 2.3cqw, 1.75rem); font-weight: 700; line-height: 1.1; }
  .role-date { margin: 7px 0 0; font-weight: 700; font-size: clamp(1.15rem, 2cqw, 1.5rem); }
  .role-date span { color: #0c579c; }
  .role-location { display: flex; align-items: center; gap: 9px; margin: 9px 0 0; font-weight: 700; font-size: clamp(1.1rem, 1.85cqw, 1.4rem); }
  .role-location img { width: 24px; height: 24px; object-fit: contain; }
  .responsibilities { display: flow-root; margin-top: -6px; padding: 6px 8px 10px; background: #f7f7f3; border: 0; }
  .responsibilities-heading { position: relative; z-index: 2; width: fit-content; max-width: 100%; margin: -3px 0 0; }
  .responsibilities-heading { --responsibilities-title-angle: -3deg; }
  .responsibilities-heading :global(.section-heading h2.hand-drawn-title) { width: max-content; min-width: 0; padding: 20px 24px 17px; font-size: clamp(1.05rem, 3.5cqw, 1.75rem); }
  .responsibilities-heading :global(.hand-drawn-title svg) { display: none; }
  .responsibilities-heading :global(.hand-drawn-title)::before { content: ""; position: absolute; inset: 10px 4px; background: var(--title-fill, #f9dfa0); border: 3px solid var(--ink); transform: skewY(var(--responsibilities-title-angle)) skewX(-7deg); }
  .responsibilities-heading :global(.hand-drawn-title > span) { transform: skewY(var(--responsibilities-title-angle)); }
  .responsibility-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; padding: 0; }
  .responsibility-card { min-width: 0; display: grid; grid-template-columns: 48px minmax(0, 1fr); align-content: start; gap: 14px; padding: 20px 16px; border: 1px solid #93999f; border-radius: 7px 9px 6px 8px; background: rgba(255,255,255,.3); box-shadow: inset 0 0 0 2px #ffffff80; }
  .responsibility-icon { width: 46px; height: 46px; fill: #a9c8e7; stroke: #173e6a; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .responsibility-icon.line-icon { fill: none; stroke-width: 3.5; }
  .responsibility-card h3 { margin: 0 0 8px; color: var(--ink); font: 600 1.12rem/1.25 "Oswald", sans-serif; }
  .responsibility-card p { margin: 0; color: var(--ink); font: 400 1rem/1.4 "Oswald", sans-serif; }
  @media (max-width: 720px) {
    .detail-nav { min-height: 58px; padding: 10px 16px; }
    .detail-brand { font-size: .9rem; }
    .detail-nav nav a { display: none; }
    .detail-nav nav a.active { display: block; }
    .experience-detail { width: calc(100% - 12px); }
    .detail-hero { height: 590px; }
    .detail-hero > img { object-position: 61% center; }
    .back-link { padding: 9px 13px 7px; font-size: .88rem; }
    .role-card { left: 17px; top: 78px; width: calc(100% - 48px); max-width: 390px; }
    .role-card h1 { font-size: clamp(2rem, 10vw, 3rem); }
    .responsibility-card { grid-template-columns: 36px minmax(0, 1fr); gap: 10px; padding: 14px 10px; }
    .responsibility-icon { width: 36px; height: 40px; }
    .responsibility-card h3 { font-size: 1rem; }
    .responsibility-card p { font-size: .9rem; }
  }
  @media (max-width: 420px) {
    .detail-hero { height: 540px; }
    .role-card { width: calc(100% - 52px); padding: 20px; }
    .responsibility-grid { grid-template-columns: 1fr; }
  }
</style>

